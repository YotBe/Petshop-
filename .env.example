# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (optional, swap for Vercel Postgres if preferred)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Admin auth (simple bearer for /admin)
ADMIN_PASSWORD=change-me

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js / NextAuth (Google sign-in)
# Generate AUTH_SECRET with: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=replace-me-with-32-byte-random-string
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
